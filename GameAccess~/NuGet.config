<?xml version="1.0" encoding="utf-8"?>
<!--
  Clears the Visual Studio fallback package folder. It is registered on this machine but does not exist on disk,
  which makes any dotnet build here fail with:

    MSB4018 ... Unable to find fallback package folder
    'C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages'

  This project pulls no packages at all, so clearing the list costs nothing.
-->
<configuration>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
